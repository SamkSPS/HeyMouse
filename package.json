{
  "name": "heymouse",
  "version": "0.1.1",
  "private": true,
  "description": "Um mouse. Um teclado. Todo o seu espaço.",
  "author": "HeyMouse contributors",
  "license": "GPL-2.0-or-later",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test desktop/*.test.ts",
    "start": "electron .",
    "engine:fetch": "node scripts/fetch-engine.mjs",
    "pack": "npm run build && electron-builder --dir",
    "pack:mac": "npm run engine:fetch && npm run build && electron-builder --mac dmg",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "app.heymouse.desktop",
    "productName": "HeyMouse",
    "asarUnpack": ["dist-desktop/edge-drop.exe", "dist-desktop/edge-drop"],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
